# ==========================================
# DEPENDENCIAS Y PLATAFORMAS DE PAQUETES
# ==========================================
**/node_modules/
**/*.pnp
**/*.pnp.*
**/*.yarn/*
**/!.yarn/patches
**/!.yarn/plugins
**/!.yarn/releases
**/!.yarn/versions

# ==========================================
# REACT / FRONTEND (Next.js, Vite, etc.)
# ==========================================
**/.next/
**/out/
**/build/
**/dist/
**/coverage/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/.vercel

# ==========================================
# SPRING BOOT / JAVA (Maven)
# ==========================================
**/target/
**/.mvn/wrapper/maven-wrapper.jar
**/HELP.md
!**/src/main/**/target/
!**/src/test/**/target/

# ==========================================
# ARCHIVOS DE CONFIGURACIÓN Y ENTORNO
# ==========================================
**/.env*
**/*.pem
**/.tsbuildinfo
**/next-env.d.ts
**/uploads/

# ==========================================
# EDITORES DE CÓDIGO (IDEs) Y SISTEMA
# ==========================================
# Archivos del Sistema
**/.DS_Store
**/Thumbs.db

# VS Code
**/.vscode/

# IntelliJ IDEA
**/.idea/
**/*.iws
**/*.iml
**/*.ipr

# Spring Tool Suite (STS) / Eclipse
**/.apt_generated
**/.classpath
**/.factorypath
**/.project
**/.settings/
**/.springBeans
**/*.sts4-cache